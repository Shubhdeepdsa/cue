# ============================================================================
# CUE v0.1 - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your secrets.
# NEVER commit .env to version control!
# ============================================================================

# Deepgram API Key (Required for Speech-to-Text)
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: Override Ollama host (defaults to http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
